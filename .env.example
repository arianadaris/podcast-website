REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Resend API key for sending contact emails
RESEND_API_KEY=

# Email address to receive contact form submissions (808s group inbox)
CONTACT_EMAIL_TO=

# Verified/allowed sender address for Resend (e.g., no-reply@yourdomain.com)
CONTACT_EMAIL_FROM=

# Disable CRA dev-server host check (dev only). Required because package.json sets a
# "proxy": react-scripts then enables a host check, and without this the dev server
# crashes with "options.allowedHosts[0] should be a non-empty string".
DANGEROUSLY_DISABLE_HOST_CHECK=true
